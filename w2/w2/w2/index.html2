// 確保 HTML 載入完成才執行，避免發生 null 錯誤
document.addEventListener('DOMContentLoaded', () => {
    
    // 取得網頁上的元素
    const resultTitle = document.getElementById('resultTitle');
    const resultImage = document.getElementById('resultImage');
    const drawButton = document.getElementById('drawButton');
    const mapLink = document.getElementById('mapLink');

    // 準備好我們的「餐廳清單」與對應的假圖片、Google地圖搜尋關鍵字
    // （圖片使用 Unsplash 的免費圖庫當作示意，你可以隨時替換成真實照片的網址）
    const foodList = [
        {
            name: "深水食堂",
            image: "https://images.unsplash.com/photo-1541614101331-1a5a3a194e92?auto=format&fit=crop&w=500&q=60",
            mapQuery: "深水食堂"
        },
        {
            name: "石二鍋",
            image: "https://images.unsplash.com/photo-1626082895617-2c6b45fdbcc0?auto=format&fit=crop&w=500&q=60",
            mapQuery: "石二鍋"
        },
        {
            name: "娜娜法國麵包",
            image: "https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=500&q=60",
            mapQuery: "娜娜法國麵包"
        },
        {
            name: "豆莊",
            image: "https://images.unsplash.com/photo-1585502120044-6330fb3cb2b7?auto=format&fit=crop&w=500&q=60",
            mapQuery: "豆莊"
        },
        {
            name: "炒飯",
            image: "https://images.unsplash.com/photo-1603133872878-684f208fb84b?auto=format&fit=crop&w=500&q=60",
            mapQuery: "炒飯"
        }
    ];

    // 當點擊「點我抽籤」按鈕時要做的事情
    drawButton.addEventListener('click', () => {
        // 1. 從陣列中隨機挑選一個項目
        const randomIndex = Math.floor(Math.random() * foodList.length);
        const selectedFood = foodList[randomIndex];

        // 2. 替換大標題文字
        resultTitle.textContent = selectedFood.name;

        // 3. 觸發彈跳動畫 (先移除 class 再加回來，讓動畫可以重複觸發)
        resultTitle.classList.remove('bounce-animation');
        // 使用一點點延遲來確保瀏覽器偵測到 class 移除，進而重新播放動畫
        setTimeout(() => {
            resultTitle.classList.add('bounce-animation');
        }, 10);

        // 4. 更新並顯示圖片
        resultImage.src = selectedFood.image;
        resultImage.style.display = 'block'; // 把原本隱藏的圖片秀出來

        // 5. 更新並顯示 Google Map 連結按鈕
        // 利用 google map 的搜尋網址結構
        mapLink.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(selectedFood.mapQuery)}`;
        mapLink.style.display = 'inline-block'; // 把原本隱藏的連結按鈕秀出來
        
        // 抽籤後改變抽籤按鈕的文字，增加互動感
        drawButton.textContent = "再抽一次！";
    });
});
